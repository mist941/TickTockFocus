{
  "manifest_version": 3,
  "name": "TickTockFocus - Advanced Timer",
  "version": "1.0",
  "description": "Powerful time management tool with customizable multi-stage timer presets. Perfect for Pomodoro technique and structured workflows.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications"]
}
