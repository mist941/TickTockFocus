{
  "manifest_version": 3,
  "name": "TickTockFocus - Multi-Step Timer & Routines",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "description": "Multi-step focus timer: Pomodoro, 52/17 or your own routine. A notification at every step. No site access, no account required.",
  "action": {
    "default_title": "TickTockFocus",
    "default_popup": "popup/popup.html",
    "default_icon": { 
      "16": "icons/icon16.png", 
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications"]
}
